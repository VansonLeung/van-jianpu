LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:5321/v1
LLM_API_KEY=noapikey
LLM_MODEL=inclusionai/ling-3.0-flash-vl:free

# Optional backend settings. The existing .env is loaded from codes/v4.
HOST=127.0.0.1
PORT=3001
LLM_MAX_TOKENS=16384
# auto disables thinking for Ling 3 models; other models keep provider defaults.
# Set enabled or disabled to override (requires provider support).
LLM_THINKING=auto
